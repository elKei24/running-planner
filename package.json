{
  "name": "running-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Adaptive, backend-free marathon training planner",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@preact/signals": "^2.0.0",
    "preact": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.0",
    "@testing-library/preact": "^3.2.4",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.14.0",
    "fast-check": "^4.0.0",
    "happy-dom": "^20.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.0"
  }
}
